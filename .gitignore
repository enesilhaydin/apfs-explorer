# ============================================================
#  NEVER COMMIT - secrets / credentials / local / large files
#  (stay careful even though this repo is isolated)
# ============================================================

# --- Secrets / credentials ---
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
id_ecdsa
*.crt
*.cer
.env
.env.*
!.env.example
*.secret
secrets/
credentials/
*-pass
*-password
*.token
.netrc
.npmrc
.cargo/credentials*
*.gpg
*.asc

# --- Local / machine-specific ---
.claude/settings.local.json
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Rust build ---
/target
**/target
**/*.rs.bk
Cargo.lock.orig

# --- Dependencies / packages ---
node_modules/
**/node_modules/

# --- Build / installer output ---
installer/build/
*.msi.tmp

# --- Logs / temporary ---
*.log
!docs/**/*.log
tmp/
*.tmp

# --- Local reference PDF (Apple-copyrighted, freely downloadable; kept local) ---
docs/Apple-File-System-Reference.pdf
docs/refs/Apple-File-System-Reference.pdf

# --- Disk images: only under tests/fixtures/ via Git LFS ---
*.dmg
*.sparseimage
*.img
!tests/fixtures/**

# Generated real APFS fixture (macOS hdiutil; regenerate via `cargo run -p xtask -- gen-fixture`)
/tests/fixtures/apfs-tiny.img
/tests/fixtures/apfs-tiny.img.manifest.json
/tests/fixtures/apfs-large.img
/tests/fixtures/apfs-large.img.manifest.json
/tests/fixtures/.apfs-large-mnt/

