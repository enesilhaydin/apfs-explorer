<?xml version="1.0" encoding="UTF-8"?>
<!-- One-installer bundle: ensure WinFsp is present (install the staged
     redistributable MSI only if its registry marker is absent), then install
     our product MSI. The product MSI (dist/apfs-explorer.msi) is the Tauri
     bundler output (GUI apfs-explorer.exe + bundled apfs-mount.exe + the
     WinFsp launcher-class registration from wix/winfsp-launcher.wxs), staged
     by `xtask package`. The operator stages the official WinFsp 2.x MSI at
     dist/winfsp.msi. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">
  <Bundle Name="APFS Explorer for Windows"
          Version="$(var.Version)"
          Manufacturer="APFS Explorer Contributors"
          UpgradeCode="2814EE00-F571-48A2-B9B6-B3B827DCF357">
    <!-- UpgradeCode STABLE - do not regenerate -->
    <BootstrapperApplicationRef
      Id="WixStandardBootstrapperApplication.RtfLicense">
      <bal:WixStandardBootstrapperApplication
        LicenseFile="wix\license.rtf" />
    </BootstrapperApplicationRef>

    <!-- WinFsp present? marker = its WOW6432Node InstallDir value. -->
    <util:RegistrySearch
      Id="WinFspInstalled"
      Variable="WinFspInstalled"
      Root="HKLM"
      Key="SOFTWARE\WOW6432Node\WinFsp"
      Value="InstallDir"
      Result="exists" />

    <Chain>
      <!-- WinFsp: installed silently by the Burn engine (the bootstrapper runs
           packages quietly). DisplayInternalUI defaults to no. The restart
           manager is disabled via an MSI property to avoid spurious "close
           running apps" dialogs. (WiX v3 MsiPackage has no MsiOptions attribute;
           MSI properties are passed via <MsiProperty> children.) -->
      <MsiPackage Id="WinFsp"
                  SourceFile="dist\winfsp.msi"
                  Permanent="yes"
                  Vital="yes"
                  InstallCondition="NOT WinFspInstalled">
        <MsiProperty Name="MSIRESTARTMANAGERCONTROL" Value="Disable" />
      </MsiPackage>
      <MsiPackage Id="ApfsExplorer"
                  SourceFile="dist\apfs-explorer.msi"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
